{
 "uid": "dora-metrics",
 "title": "DORA metrics",
 "tags": [
  "dora"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1
   },
   {
    "name": "environment",
    "label": "Environment",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(dora_exporter_last_poll_timestamp_seconds, environment)",
    "definition": "label_values(dora_exporter_last_poll_timestamp_seconds, environment)",
    "refresh": 2,
    "sort": 1,
    "multi": false,
    "includeAll": false,
    "allValue": ".*",
    "current": {},
    "hide": 0
   },
   {
    "name": "repo",
    "label": "Repo",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(dora_pr_stage_seconds_count{environment=\"$environment\"}, repo)",
    "definition": "label_values(dora_pr_stage_seconds_count{environment=\"$environment\"}, repo)",
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {},
    "hide": 0
   },
   {
    "name": "app",
    "label": "App",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(dora_deployments_total{environment=\"$environment\", repo=~\"$repo\"}, app)",
    "definition": "label_values(dora_deployments_total{environment=\"$environment\", repo=~\"$repo\"}, app)",
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {},
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "DORA headline (selected range)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Deployments",
   "description": "Successful Argo CD syncs of the selected apps. One repo can feed several apps, so a release counts once per app.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(increase(dora_deployments_total{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\",result=\"success\"}[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Lead time p50",
   "description": "Per commit: commit time to deployment (Argo CD sync). Per repo.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_lead_time_seconds_bucket{environment=\"$environment\",repo=~\"$repo\"}[$__range])))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Lead time p90",
   "description": "As above, 90th percentile.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.9, sum by (le) (increase(dora_lead_time_seconds_bucket{environment=\"$environment\",repo=~\"$repo\"}[$__range])))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Change failure rate",
   "description": "Failed or degraded syncs / all syncs.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(sum(increase(dora_deployments_total{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\",result=\"failure\"}[$__range])) or vector(0)) / sum(increase(dora_deployments_total{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\"}[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Time to restore p50",
   "description": "From a failed or degraded sync to the next healthy sync.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_restore_time_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\"}[$__range])))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Since last deployment",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "time() - max(dora_last_deployment_timestamp_seconds{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 8,
   "type": "row",
   "title": "Deployments and lead time",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Deployments per hour",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (app) (increase(dora_deployments_total{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\",result=\"success\"}[1h]))",
     "legendFormat": "{{app}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 0,
      "fillOpacity": 60,
      "spanNulls": true,
      "showPoints": "auto",
      "drawStyle": "bars",
      "barAlignment": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Lead time for changes (rolling 1h)",
   "description": "Per-commit lead time, observed when a commit reaches the environment.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_lead_time_seconds_bucket{environment=\"$environment\",repo=~\"$repo\"}[1h])))",
     "legendFormat": "p50",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.9, sum by (le) (increase(dora_lead_time_seconds_bucket{environment=\"$environment\",repo=~\"$repo\"}[1h])))",
     "legendFormat": "p90",
     "refId": "B",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true,
      "showPoints": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "row",
   "title": "Where the time goes",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 12,
   "type": "bargauge",
   "title": "Median time per stage",
   "description": "coding = first commit to PR opened; draft = opened to ready for review; review = ready to merge; build queue/build = package workflow; image update = package done to GitOps write-back; rollout = package done to sync.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_pr_stage_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",stage=\"coding\"}[$__range])))",
     "legendFormat": "coding",
     "refId": "A",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_pr_stage_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",stage=\"draft\"}[$__range])))",
     "legendFormat": "draft",
     "refId": "B",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_pr_stage_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",stage=\"review\"}[$__range])))",
     "legendFormat": "review",
     "refId": "C",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_build_queue_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",conclusion=\"success\"}[$__range])))",
     "legendFormat": "build queue",
     "refId": "D",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_build_duration_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",conclusion=\"success\"}[$__range])))",
     "legendFormat": "build",
     "refId": "E",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_image_update_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\"}[$__range])))",
     "legendFormat": "image update",
     "refId": "F",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_rollout_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\"}[$__range])))",
     "legendFormat": "rollout (incl. image update)",
     "refId": "G",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Median per stage (rolling 1h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_pr_stage_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",stage=\"coding\"}[1h])))",
     "legendFormat": "coding",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_pr_stage_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",stage=\"draft\"}[1h])))",
     "legendFormat": "draft",
     "refId": "B",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_pr_stage_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",stage=\"review\"}[1h])))",
     "legendFormat": "review",
     "refId": "C",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_build_duration_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",conclusion=\"success\"}[1h])))",
     "legendFormat": "build",
     "refId": "D",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_rollout_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",app=~\"$app\"}[1h])))",
     "legendFormat": "rollout",
     "refId": "E",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true,
      "showPoints": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 14,
   "type": "row",
   "title": "Pull requests",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "PRs merged per hour",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (base) (increase(dora_pr_stage_seconds_count{environment=\"$environment\",repo=~\"$repo\",stage=\"review\"}[1h]))",
     "legendFormat": "into {{base}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 0,
      "fillOpacity": 60,
      "spanNulls": true,
      "showPoints": "auto",
      "drawStyle": "bars",
      "barAlignment": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Draft time (rolling 1h)",
   "description": "PR opened to marked ready for review (0 if never a draft).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (increase(dora_pr_stage_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",stage=\"draft\"}[1h])))",
     "legendFormat": "p50",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.9, sum by (le) (increase(dora_pr_stage_seconds_bucket{environment=\"$environment\",repo=~\"$repo\",stage=\"draft\"}[1h])))",
     "legendFormat": "p90",
     "refId": "B",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true,
      "showPoints": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Review time (rolling 1h)",
   "description": "Ready for review to merged.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
